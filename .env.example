# 复制为 .env 后填写。禁止提交真实密钥。
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
AGENT_MAX_STEPS=4

# mock：确定性测试/演示；real：调用已配置模型。
AGENT_MODE=mock

# 只读知识检索；仅 true 开启。后端启动进程环境变量控制，修改后重启。
KNOWLEDGE_ENABLED=true
