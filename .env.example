# 复制为 .env 后填写。禁止提交真实密钥。
LLM_API_KEY=
# 文字服务仅支持 deepseek；DEEPSEEK_API_KEY 优先，空值兼容上面的旧密钥。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# 可选独立 Tavily 密钥；留空时搜索诚实返回“未配置”，不会借用模型密钥。
TAVILY_API_KEY=
# 可选聊天 SQLite 路径；默认位于工单数据目录。勿让多个服务进程共享。
# CHAT_STORE_PATH=data/chat-sessions.sqlite3
LLM_MODEL=deepseek-v4-flash
# 右下角建议列表，逗号分隔；页面也可输入符合格式的自定义DeepSeek模型标识。
LLM_MODEL_OPTIONS=deepseek-v4-pro
VISION_MODEL=deepseek-v4-flash-vision-exp
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
AGENT_MAX_STEPS=4

# mock：确定性测试/演示；real：调用已配置模型。
AGENT_MODE=mock

# 只读知识检索；仅 true 开启。后端启动进程环境变量控制，修改后重启。
KNOWLEDGE_ENABLED=true
