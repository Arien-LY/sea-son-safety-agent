# 复制为 .env 后填写。禁止提交真实密钥。
# 文字服务商：deepseek（默认，保留现有 DeepSeek 接入）或 tencent_token_plan（腾讯云 Token Plan）。
LLM_PROVIDER=deepseek
# DeepSeek 文字配置（LLM_PROVIDER=deepseek 时生效）。
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# 右下角建议列表，逗号分隔；页面也可输入符合格式的自定义模型标识。
LLM_MODEL_OPTIONS=deepseek-v4-pro
# 腾讯云 Token Plan 文字配置（LLM_PROVIDER=tencent_token_plan 时生效）。
# Base URL 只允许腾讯云官方 OpenAI 兼容入口；Model ID 见 Token Plan 控制台套餐支持列表。
TENCENT_TOKEN_PLAN_API_KEY=
TENCENT_TOKEN_PLAN_MODEL=deepseek-v4-flash-202605
TENCENT_TOKEN_PLAN_MODEL_OPTIONS=deepseek-v4-pro-202606
TENCENT_TOKEN_PLAN_BASE_URL=https://api.lkeap.cloud.tencent.com/plan/v3
# 图片分析仍走 DeepSeek 官方视觉模型；如需与文字服务商分开，可单独指定图片密钥与端点。
VISION_MODEL=deepseek-v4-flash-vision-exp
VISION_API_KEY=
VISION_BASE_URL=https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
AGENT_MAX_STEPS=4

# mock：确定性测试/演示；real：调用已配置模型。
AGENT_MODE=mock

# 只读知识检索；仅 true 开启。后端启动进程环境变量控制，修改后重启。
KNOWLEDGE_ENABLED=true
