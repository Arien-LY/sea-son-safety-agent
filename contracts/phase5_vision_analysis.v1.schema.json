{
  "$defs": {
    "IssueAnalysis": {
      "additionalProperties": false,
      "description": "模型分析结果；不能直接创建或修改业务记录。",
      "properties": {
        "category": {
          "$ref": "#/$defs/IssueCategory"
        },
        "issue_type": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Issue Type",
          "type": "string"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "observed_facts": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Observed Facts",
          "type": "array"
        },
        "uncertainties": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Uncertainties",
          "type": "array"
        },
        "missing_fields": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Missing Fields",
          "type": "array"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel"
        },
        "immediate_actions": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Immediate Actions",
          "type": "array"
        },
        "suggested_actions": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Suggested Actions",
          "type": "array"
        },
        "recommended_route": {
          "$ref": "#/$defs/RecommendedRoute"
        },
        "requires_human_review": {
          "title": "Requires Human Review",
          "type": "boolean"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "category",
        "issue_type",
        "summary",
        "observed_facts",
        "uncertainties",
        "missing_fields",
        "risk_level",
        "immediate_actions",
        "suggested_actions",
        "recommended_route",
        "requires_human_review",
        "confidence"
      ],
      "title": "IssueAnalysis",
      "type": "object"
    },
    "IssueCategory": {
      "enum": [
        "safety",
        "quality",
        "management",
        "logistics",
        "consultation",
        "unknown"
      ],
      "title": "IssueCategory",
      "type": "string"
    },
    "RecommendedRoute": {
      "enum": [
        "direct_answer",
        "collect_more_info",
        "propose_workflow",
        "human_review"
      ],
      "title": "RecommendedRoute",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "undetermined",
        "low",
        "medium",
        "high",
        "emergency"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "VisualCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^CAND-[1-5]$",
          "title": "Candidate Id",
          "type": "string"
        },
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Observation Ids",
          "type": "array"
        },
        "analysis": {
          "$ref": "#/$defs/IssueAnalysis"
        }
      },
      "required": [
        "candidate_id",
        "observation_ids",
        "analysis"
      ],
      "title": "VisualCandidate",
      "type": "object"
    },
    "VisualObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "maxLength": 6,
          "pattern": "^OBS-[1-9][0-9]?$",
          "title": "Observation Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "uncertain",
            "not_observed"
          ],
          "title": "Status",
          "type": "string"
        },
        "description": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "status",
        "description"
      ],
      "title": "VisualObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "preliminary_only": {
      "const": true,
      "title": "Preliminary Only",
      "type": "boolean"
    },
    "requires_human_review": {
      "const": true,
      "title": "Requires Human Review",
      "type": "boolean"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/VisualObservation"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "limitations": {
      "items": {
        "enum": [
          "low_resolution",
          "blurred",
          "occluded",
          "context_missing"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "title": "Limitations",
      "type": "array"
    },
    "follow_up_questions": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Follow Up Questions",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/VisualCandidate"
      },
      "maxItems": 5,
      "title": "Candidates",
      "type": "array"
    }
  },
  "required": [
    "preliminary_only",
    "requires_human_review",
    "observations",
    "limitations",
    "follow_up_questions",
    "candidates"
  ],
  "title": "VisionAnalysis",
  "type": "object"
}
