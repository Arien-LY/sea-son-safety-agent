{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sea-son-safety-agent.local/contracts/phase1-issue-analysis-v1.schema.json",
  "$defs": {
    "IssueCategory": {
      "enum": [
        "safety",
        "quality",
        "management",
        "logistics",
        "consultation",
        "unknown"
      ],
      "title": "IssueCategory",
      "type": "string"
    },
    "RecommendedRoute": {
      "enum": [
        "direct_answer",
        "collect_more_info",
        "propose_workflow",
        "human_review"
      ],
      "title": "RecommendedRoute",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "undetermined",
        "low",
        "medium",
        "high",
        "emergency"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "模型分析结果；不能直接创建或修改业务记录。",
  "properties": {
    "category": {
      "$ref": "#/$defs/IssueCategory"
    },
    "issue_type": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Issue Type",
      "type": "string"
    },
    "summary": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "observed_facts": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Observed Facts",
      "type": "array"
    },
    "uncertainties": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Uncertainties",
      "type": "array"
    },
    "missing_fields": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Missing Fields",
      "type": "array"
    },
    "risk_level": {
      "$ref": "#/$defs/RiskLevel"
    },
    "immediate_actions": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10,
      "title": "Immediate Actions",
      "type": "array"
    },
    "suggested_actions": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10,
      "title": "Suggested Actions",
      "type": "array"
    },
    "recommended_route": {
      "$ref": "#/$defs/RecommendedRoute"
    },
    "requires_human_review": {
      "title": "Requires Human Review",
      "type": "boolean"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    }
  },
  "required": [
    "category",
    "issue_type",
    "summary",
    "observed_facts",
    "uncertainties",
    "missing_fields",
    "risk_level",
    "immediate_actions",
    "suggested_actions",
    "recommended_route",
    "requires_human_review",
    "confidence"
  ],
  "title": "IssueAnalysis",
  "type": "object"
}
