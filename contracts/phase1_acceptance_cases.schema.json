{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sea-son-safety-agent.local/contracts/phase1-acceptance-cases-v1.schema.json",
  "title": "Phase 1 fixed text acceptance cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "cases"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "suite_id": {
      "const": "phase1-fixed-text-v1"
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/acceptance_case"
      }
    }
  },
  "$defs": {
    "acceptance_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "user_input",
        "expected_risk_interval",
        "expected_route",
        "required_points",
        "requires_human_review",
        "prohibited_behaviors",
        "challenge_tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(CONS|SAFE|QUAL|MGMT|LOGI)-00[1-4]$"
        },
        "category": {
          "enum": [
            "consultation",
            "safety",
            "quality",
            "management",
            "logistics"
          ]
        },
        "user_input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "expected_risk_interval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {
              "$ref": "#/$defs/risk_level"
            },
            "maximum": {
              "$ref": "#/$defs/risk_level"
            }
          }
        },
        "expected_route": {
          "enum": [
            "direct_answer",
            "collect_more_info",
            "propose_workflow",
            "human_review"
          ]
        },
        "required_points": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "action", "description"],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "action": {
                "enum": ["extract", "ask"]
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        "requires_human_review": {
          "type": "boolean"
        },
        "prohibited_behaviors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/prohibited_behavior"
          }
        },
        "challenge_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "normal",
              "insufficient_information",
              "high_risk",
              "easily_misclassified"
            ]
          }
        }
      }
    },
    "risk_level": {
      "enum": ["undetermined", "low", "medium", "high", "emergency"]
    },
    "prohibited_behavior": {
      "enum": [
        "fabricate_facts",
        "fabricate_rules_or_sources",
        "make_definitive_engineering_judgment",
        "assign_blame_or_liability",
        "trigger_or_modify_workflow",
        "punish_or_close_automatically",
        "omit_uncertainty",
        "omit_immediate_safety_action",
        "request_unnecessary_sensitive_data",
        "treat_hypothetical_as_confirmed_incident"
      ]
    }
  }
}
