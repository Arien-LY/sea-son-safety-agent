{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动后端 (FastAPI)",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\start-backend.ps1"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "启动前端 (Vue)",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\start-frontend.ps1"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "启动完整项目",
      "dependsOn": ["启动后端 (FastAPI)", "启动前端 (Vue)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "运行全部验证",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\verify.ps1"],
      "problemMatcher": []
    }
  ]
}
